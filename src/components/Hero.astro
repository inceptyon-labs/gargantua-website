---
import { Image } from "astro:assets";
import CopyCommand from "./CopyCommand.astro";
import logo from "../assets/gargantua-logo.png";
import dashboard from "../assets/screenshots/dashboard.png";

const trustSignals = [
  "AGPL-3.0, free at the source",
  "Telemetry-free",
  "Apple Silicon, macOS 14+",
];
---

<section
  id="top"
  class="relative overflow-hidden border-b border-edge-soft bg-void-deep pb-20 pt-24 sm:pb-28 sm:pt-32"
>
  <!-- atmospheric field: starfield + ambient glow, behind content -->
  <div class="hero-field" aria-hidden="true">
    <div class="hero-stars"></div>
    <div class="hero-glow"></div>
  </div>

  <div
    class="relative mx-auto flex max-w-[1180px] flex-col items-center px-5 text-center sm:px-8"
  >
    <!-- gravitational anchor: the disk is centered on the logo itself, so
         the background band reads as the logo's own disk continuing outward -->
    <div class="hero-anchor reveal mb-6 sm:mb-7">
      <div class="hero-disk" aria-hidden="true">
        <div class="disk-band"></div>
        <div class="disk-streaks"></div>
        <div class="disk-clumps"></div>
      </div>
      <div class="hero-horizon" aria-hidden="true"></div>
      <Image
        src={logo}
        alt="The Gargantua black hole: a dark core wrapped in a bright accretion disk"
        widths={[160, 240, 320]}
        sizes="(max-width: 640px) 120px, 184px"
        class="relative h-[120px] w-[120px] sm:h-[184px] sm:w-[184px]"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <p class="t-marker reveal mb-5" style="--reveal-delay: 60ms">
      <span class="text-accretion">//</span> native macOS cleaner for developers
    </p>

    <h1 class="t-hero reveal max-w-[16ch]" style="--reveal-delay: 120ms">
      The Mac cleaner that shows its work.
    </h1>

    <p
      class="t-body-lg reveal measure-wide mt-6 text-pretty"
      style="--reveal-delay: 200ms"
    >
      Gargantua scans the caches, build artifacts, duplicates, and app remnants
      piling up on your Mac. Every file it touches traces to a named rule that
      shows you why it is safe to remove, so you clean without taking anything on
      faith.
    </p>

    <div
      class="reveal mt-9 flex w-full max-w-md flex-col items-stretch gap-3"
      style="--reveal-delay: 280ms"
    >
      <CopyCommand
        lines={["brew install --cask inceptyon-labs/tap/gargantua"]}
      />
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
        <a
          href="https://github.com/inceptyon-labs/gargantua/releases"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm font-medium text-accent transition-colors hover:text-accent-bright"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <path d="M7 10l5 5 5-5"></path>
            <path d="M12 15V3"></path>
          </svg>
          Download the DMG instead
        </a>
        <span class="h-3 w-px bg-edge-em" aria-hidden="true"></span>
        <a
          href="#install"
          class="text-sm font-medium text-ink-2 transition-colors hover:text-ink"
        >
          Full install steps
        </a>
        <span class="h-3 w-px bg-edge-em" aria-hidden="true"></span>
        <a
          href="https://github.com/inceptyon-labs/gargantua"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-2 transition-colors hover:text-ink"
        >
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.46-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.32 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.82 0 .27.18.6.69.49A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"
            ></path>
          </svg>
          View source
        </a>
      </div>
    </div>

    <ul
      class="reveal mt-8 flex flex-wrap items-center justify-center gap-x-5 gap-y-2"
      style="--reveal-delay: 360ms"
    >
      {
        trustSignals.map((signal) => (
          <li class="flex items-center gap-2 t-caption">
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--color-safe)"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 6 9 17l-5-5" />
            </svg>
            {signal}
          </li>
        ))
      }
    </ul>

    <!-- real product surface -->
    <figure
      class="hero-shot reveal mt-16 w-full max-w-[960px]"
      style="--reveal-delay: 440ms"
    >
      <div
        class="overflow-hidden rounded-xl border border-edge bg-surface-1"
      >
        <Image
          src={dashboard}
          alt="Gargantua's dashboard: a 97% used storage gauge, a cleanup roadmap, and ranked next actions from triage to deep clean"
          widths={[760, 960, 1440, 1920]}
          sizes="(max-width: 1000px) 100vw, 960px"
          class="block w-full"
          loading="lazy"
        />
      </div>
      <figcaption class="t-caption mt-3 text-center">
        The dashboard ranks where to dig in next. No file is selected for you
        without a rule and a rating behind it.
      </figcaption>
    </figure>
  </div>
</section>

<script>
  // Pause the disk/glow/float loops while the hero is scrolled away.
  const hero = document.getElementById("top");
  if (hero && "IntersectionObserver" in window) {
    new IntersectionObserver(([entry]) => {
      hero.classList.toggle("hero-asleep", !entry.isIntersecting);
    }).observe(hero);
  }
</script>

<style>
  .hero-field {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* faint starfield, fully static */
  .hero-stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 12% 18%, #ffffff55, transparent),
      radial-gradient(1px 1px at 28% 42%, #ffffff33, transparent),
      radial-gradient(1px 1px at 47% 12%, #ffffff44, transparent),
      radial-gradient(1.5px 1.5px at 63% 28%, #ffffff40, transparent),
      radial-gradient(1px 1px at 78% 9%, #ffffff33, transparent),
      radial-gradient(1px 1px at 88% 36%, #ffffff44, transparent),
      radial-gradient(1px 1px at 8% 64%, #ffffff2e, transparent),
      radial-gradient(1px 1px at 71% 58%, #ffffff2e, transparent);
    background-repeat: no-repeat;
    opacity: 0.7;
    mask-image: radial-gradient(
      120% 80% at 50% 18%,
      #000 0%,
      #000 45%,
      transparent 78%
    );
  }

  /* accretion light bleeding into the void from the anchor */
  .hero-glow {
    position: absolute;
    left: 50%;
    top: clamp(40px, 8vw, 110px);
    width: min(900px, 120vw);
    aspect-ratio: 1.7 / 1;
    translate: -50% 0;
    rotate: -16deg;
    background:
      radial-gradient(
        50% 50% at 50% 45%,
        color-mix(in oklab, var(--color-accretion) 36%, transparent) 0%,
        color-mix(in oklab, var(--color-accretion) 11%, transparent) 38%,
        transparent 70%
      );
    filter: blur(36px);
    opacity: 0.85;
    animation: glow-breathe 9s var(--ease-out-quint) infinite alternate;
  }

  /* The disk proper: a flat plane of orbiting material, foreshortened into
     an ellipse, centered on the logo and tilted to the logo's own disk axis
     so it reads as the same disk continuing outward. */
  .hero-disk {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(840px, 135vw);
    aspect-ratio: 1;
    translate: -50% -50%;
    transform: rotate(-16deg) scaleY(0.3);
    pointer-events: none;
  }

  /* main band: doppler-bright on the approaching (left) side, dim trailing
     arc on the right, a gap fore and aft so it reads as seen edge-on */
  .disk-band {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      transparent 2deg,
      color-mix(in oklab, var(--color-accretion) 30%, transparent) 38deg,
      color-mix(in oklab, var(--color-accretion) 48%, transparent) 80deg,
      color-mix(in oklab, var(--color-accretion) 26%, transparent) 130deg,
      transparent 168deg,
      transparent 196deg,
      color-mix(in oklab, var(--color-accretion) 42%, transparent) 242deg,
      color-mix(in oklab, var(--color-accretion-hot) 78%, transparent) 282deg,
      color-mix(in oklab, #ffe2b0 55%, transparent) 296deg,
      color-mix(in oklab, var(--color-accretion-hot) 60%, transparent) 312deg,
      color-mix(in oklab, var(--color-accretion) 28%, transparent) 340deg,
      transparent 358deg
    );
    mask-image: radial-gradient(
      closest-side,
      transparent 52%,
      #000 66%,
      #000 82%,
      transparent 95%
    );
    -webkit-mask-image: radial-gradient(
      closest-side,
      transparent 52%,
      #000 66%,
      #000 82%,
      transparent 95%
    );
    filter: blur(9px);
    opacity: 0.5;
  }

  /* inner rim: a tighter, hotter band hugging the hole, smooth like the
     main band but offset in phase so the two drift against each other */
  .disk-streaks {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 24deg,
      transparent 8deg,
      color-mix(in oklab, var(--color-accretion) 24%, transparent) 70deg,
      transparent 150deg,
      transparent 215deg,
      color-mix(in oklab, var(--color-accretion-hot) 46%, transparent) 275deg,
      color-mix(in oklab, var(--color-accretion) 22%, transparent) 320deg,
      transparent 352deg
    );
    mask-image: radial-gradient(
      closest-side,
      transparent 50%,
      #000 60%,
      #000 70%,
      transparent 80%
    );
    -webkit-mask-image: radial-gradient(
      closest-side,
      transparent 50%,
      #000 60%,
      #000 70%,
      transparent 80%
    );
    filter: blur(7px);
    opacity: 0.45;
  }

  /* orbiting material: soft clumps riding the band. The lighting (the two
     bands above) stays fixed to the viewer; only the matter moves. */
  .disk-clumps {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(
        10% 5% at 84% 62%,
        color-mix(in oklab, var(--color-accretion-hot) 60%, transparent),
        transparent 70%
      ),
      radial-gradient(
        13% 6% at 38% 84%,
        color-mix(in oklab, var(--color-accretion) 55%, transparent),
        transparent 70%
      ),
      radial-gradient(
        8% 4% at 16% 38%,
        color-mix(in oklab, var(--color-accretion-hot) 45%, transparent),
        transparent 70%
      ),
      radial-gradient(
        11% 5% at 68% 19%,
        color-mix(in oklab, var(--color-accretion) 50%, transparent),
        transparent 70%
      ),
      radial-gradient(
        7% 4% at 25% 70%,
        color-mix(in oklab, #ffe2b0 40%, transparent),
        transparent 70%
      );
    mask-image: radial-gradient(
      closest-side,
      transparent 50%,
      #000 60%,
      #000 84%,
      transparent 95%
    );
    -webkit-mask-image: radial-gradient(
      closest-side,
      transparent 50%,
      #000 60%,
      #000 84%,
      transparent 95%
    );
    filter: blur(6px);
    opacity: 0.8;
    animation: disk-rotate 26s linear infinite;
  }

  /* dark gravity well seating the anchor into the field, so the disk reads
     as passing behind the hole rather than through the logo */
  .hero-horizon {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(460px, 76vw);
    aspect-ratio: 1;
    translate: -50% -50%;
    background: radial-gradient(
      closest-side,
      #0b0c0f 0%,
      color-mix(in oklab, #0b0c0f 82%, transparent) 42%,
      transparent 72%
    );
    pointer-events: none;
  }

  .hero-anchor {
    position: relative;
  }
  .hero-anchor :global(img) {
    animation: anchor-float 7s var(--ease-out-quint) infinite alternate;
    filter: drop-shadow(
      0 0 40px color-mix(in oklab, var(--color-accretion) 30%, transparent)
    );
  }

  .hero-shot :global(img) {
    /* keep the screenshot reading as a lit object above the void */
    box-shadow: 0 0 0 1px transparent;
  }

  @keyframes glow-breathe {
    from {
      opacity: 0.62;
      scale: 0.97;
    }
    to {
      opacity: 0.92;
      scale: 1.04;
    }
  }
  @keyframes disk-rotate {
    from {
      rotate: 0deg;
    }
    to {
      rotate: 360deg;
    }
  }
  @keyframes anchor-float {
    from {
      translate: 0 -5px;
    }
    to {
      translate: 0 5px;
    }
  }

  /* the show pauses whenever the hero is off-screen */
  .hero-asleep .hero-glow,
  .hero-asleep .disk-clumps,
  .hero-asleep .hero-anchor :global(img) {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-glow,
    .disk-clumps,
    .hero-anchor :global(img) {
      animation: none;
    }
    .hero-glow {
      opacity: 0.8;
      scale: 1;
    }
  }
</style>
