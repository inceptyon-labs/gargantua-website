---
// Explainability engines: from rule-based default to bring-your-own-cloud.
// Accurate to the app's Settings -> AI engines.

const engines = [
  {
    name: "Template",
    badge: "On by default",
    badgeTone: "default",
    net: "Local-only",
    netTone: "safe",
    desc: "Plain-language explanations straight from each rule's own metadata. No model, no network, no wait.",
    where: "Nothing to install",
  },
  {
    name: "Local MLX",
    badge: "Opt-in",
    badgeTone: "muted",
    net: "Local-only",
    netTone: "safe",
    desc: "A small Llama model runs on Apple Silicon for richer summaries. Loads on demand, unloads when idle.",
    where: "~700 MB, on your Mac",
  },
  {
    name: "Cloud (Anthropic)",
    badge: "Opt-in",
    badgeTone: "muted",
    net: "Your account",
    netTone: "accent",
    desc: "Bring your own Anthropic key for Claude-grade reasoning. Paths and sizes only; file previews stay off until you allow them. Hard monthly spend cap.",
    where: "Key in macOS Keychain",
  },
  {
    name: "Claude Code Agent",
    badge: "Opt-in",
    badgeTone: "muted",
    net: "Local agent",
    netTone: "accent",
    desc: "Hand a scan to the Claude Code CLI for hands-off maintenance runs. Read-only tools by default; destructive ones need an explicit grant.",
    where: "CLI manages its own auth",
  },
];

const toneColor: Record<string, string> = {
  safe: "var(--color-safe)",
  accent: "var(--color-accent)",
};
---

<section class="border-b border-edge-soft bg-void py-20 sm:py-28">
  <div class="mx-auto max-w-[1180px] px-5 sm:px-8">
    <div class="reveal max-w-[52ch]">
      <h2 class="t-display">Ask why. Choose who answers.</h2>
      <p class="t-body-lg mt-5">
        Every finding already carries a plain-language reason from its rule. Want
        more, a summary of a whole scan, a comparison, the reasoning behind a
        rating? Layer on a local model or your own cloud account. The default needs
        neither.
      </p>
    </div>

    <!-- local -> cloud axis -->
    <div class="reveal mt-10 flex items-center gap-3" style="--reveal-delay: 60ms">
      <span class="t-caption font-mono uppercase tracking-wide text-ink-3">Local</span>
      <span
        class="h-px flex-1"
        style="background: linear-gradient(90deg, var(--color-safe), var(--color-accent))"
        aria-hidden="true"></span>
      <span class="t-caption font-mono uppercase tracking-wide text-ink-3">Cloud</span>
    </div>

    <div class="mt-4 grid gap-px overflow-hidden rounded-2xl border border-edge bg-edge md:grid-cols-2 xl:grid-cols-4">
      {
        engines.map((e, i) => (
          <div
            class="reveal flex flex-col bg-surface-1 p-6"
            style={`--reveal-delay: ${100 + i * 70}ms`}
          >
            <div class="flex items-center justify-between gap-2">
              <h3 class="t-title">{e.name}</h3>
              {e.badgeTone === "default" ? (
                <span class="rounded-full bg-surface-3 px-2 py-0.5 t-caption font-medium text-accretion">
                  {e.badge}
                </span>
              ) : (
                <span class="rounded-full border border-edge-soft px-2 py-0.5 t-caption text-ink-3">
                  {e.badge}
                </span>
              )}
            </div>

            <div class="mt-3 flex items-center gap-2">
              <span
                class="inline-block h-1.5 w-1.5 rounded-full"
                style={`background:${toneColor[e.netTone]}`}
                aria-hidden="true"
              />
              <span class="t-caption font-mono" style={`color:${toneColor[e.netTone]}`}>
                {e.net}
              </span>
            </div>

            <p class="t-body mt-3 grow">{e.desc}</p>

            <p class="t-caption mt-4 border-t border-edge-soft pt-3 font-mono text-ink-3">
              {e.where}
            </p>
          </div>
        ))
      }
    </div>

    <!-- the rule that ties back to the trust layer -->
    <div
      class="reveal mt-6 flex items-start gap-3 rounded-xl border border-edge bg-surface-1 p-5"
      style="--reveal-delay: 120ms"
    >
      <svg
        class="mt-0.5 shrink-0"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="var(--color-accretion)"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
      </svg>
      <p class="t-body text-ink-2">
        One rule across all four: a model can <span class="text-ink">explain</span>
        a rating, never lower it. A <span class="text-protected">protected</span>
        finding stays protected no matter what any model, local or cloud, says
        about it.
      </p>
    </div>
  </div>
</section>
