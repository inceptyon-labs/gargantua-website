---
interface Props {
  size?: number;
  withWordmark?: boolean;
  class?: string;
}
const { size = 28, withWordmark = false, class: className = "" } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg
    width={size}
    height={size}
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    class="shrink-0"
  >
    <ellipse
      cx="16"
      cy="16"
      rx="13"
      ry="4.6"
      stroke="url(#bm-disk)"
      stroke-width="2.2"
      fill="none"
    ></ellipse>
    <circle cx="16" cy="16" r="6.4" fill="#0F1115"></circle>
    <circle cx="16" cy="16" r="6.4" stroke="#FFC061" stroke-width="0.6" opacity="0.55"
    ></circle>
    <defs>
      <linearGradient
        id="bm-disk"
        x1="3"
        y1="16"
        x2="29"
        y2="16"
        gradientUnits="userSpaceOnUse"
      >
        <stop stop-color="#F0951E"></stop>
        <stop offset="0.5" stop-color="#FFC061"></stop>
        <stop offset="1" stop-color="#F0951E"></stop>
      </linearGradient>
    </defs>
  </svg>
  {
    withWordmark && (
      <span class="text-[0.9375rem] font-semibold tracking-tight text-ink">
        Gargantua
      </span>
    )
  }
</span>
